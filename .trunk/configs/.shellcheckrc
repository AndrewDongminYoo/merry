enable=all
source-path=SCRIPTDIR
disable=SC2154
# SC2312 fires on every command substitution and process substitution, including
# `< <(git ls-files …)` where the only failure mode is git itself being broken —
# which the surrounding pipeline catches under `set -o pipefail` anyway.
disable=SC2312

# If you're having issues with shellcheck following source, disable the errors via:
# disable=SC1090
# disable=SC1091
